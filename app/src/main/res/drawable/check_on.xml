<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="20dp" android:height="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/ink" />
        </shape>
    </item>
    <item android:width="10dp" android:height="10dp" android:gravity="center">
        <shape android:shape="rectangle"><solid android:color="@color/accent" /></shape>
    </item>
</layer-list>
